<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/coordinator_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Hauptbereich: MapLibre GL MapView -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <org.maplibre.android.maps.MapView
            android:id="@+id/map_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Header / App Bar Overlay -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@color/surface"
            app:strokeWidth="1dp"
            app:strokeColor="@color/divider">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_name"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary" />

                    <TextView
                        android:id="@+id/tv_status_info"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GPS-Erfassung &amp; OSM-Karte"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>

                <!-- Counter Badge -->
                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_records_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 Fotos"
                    android:textColor="@color/primary"
                    app:chipBackgroundColor="@color/surface_variant"
                    app:chipStrokeColor="@color/primary_light"
                    app:chipStrokeWidth="1dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Floating Action Buttons rechts unten (über dem BottomSheet) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginBottom="96dp"
            android:layout_marginEnd="16dp"
            android:orientation="vertical"
            android:gravity="end">

            <!-- Ortungs-Button (FusedLocationProviderClient) -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fab_locate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:contentDescription="@string/action_locate"
                app:backgroundTint="@color/surface"
                app:tint="@color/primary"
                app:fabSize="mini"
                app:elevation="4dp"
                app:srcCompat="@drawable/ic_my_location" />

            <!-- Listenansicht Button -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fab_toggle_list"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:contentDescription="@string/action_show_list"
                app:backgroundTint="@color/surface"
                app:tint="@color/primary"
                app:fabSize="mini"
                app:elevation="4dp"
                app:srcCompat="@drawable/ic_list" />

            <!-- Kamera-Button (Foto mit GPS erfassen) -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fab_camera"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/action_camera"
                app:backgroundTint="@color/secondary"
                app:tint="@color/white"
                app:fabSize="normal"
                app:elevation="6dp"
                app:srcCompat="@drawable/ic_camera" />

        </LinearLayout>
    </FrameLayout>

    <!-- Bottom Sheet: Liste aller aufgenommenen Fotos -->
    <androidx.cardview.widget.CardView
        android:id="@+id/bottom_sheet_records"
        android:layout_width="match_parent"
        android:layout_height="420dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="12dp"
        app:cardBackgroundColor="@color/surface"
        app:behavior_hideable="false"
        app:behavior_peekHeight="76dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Drag Handle & Header -->
            <LinearLayout
                android:id="@+id/bottom_sheet_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingTop="10dp"
                android:paddingBottom="12dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:background="?attr/selectableItemBackground">

                <!-- Handle Bar -->
                <View
                    android:layout_width="40dp"
                    android:layout_height="4dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/handle_pill" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/tv_records_header"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:text="@string/title_records"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:id="@+id/tv_swipe_hint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="Nach oben wischen ▲"
                        android:textSize="12sp"
                        android:textColor="@color/text_muted" />
                </RelativeLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider" />

            <!-- Leerer Zustand -->
            <TextView
                android:id="@+id/tv_empty_state"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:padding="32dp"
                android:text="@string/no_records"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:visibility="gone" />

            <!-- RecyclerView für erfasste Fotos -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_view_records"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:padding="12dp"
                tools:listitem="@layout/item_record" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
